# Copy to .env (git-ignored) and adjust. docker-compose.yml reads it automatically.

# Database created inside the "db" container.
DB_NAME=ecommerce
DB_USERNAME=postgres
DB_PASSWORD=admin

# Google OAuth2 client (optional - leave empty and only email/password sign-in works).
# Redirect URI to register in Google Cloud Console: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
