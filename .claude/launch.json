{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend/eCommerce-client",
        "start"
      ],
      "port": 4200
    },
    {
      "name": "backend",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "Set-Location backend/eCommerce; ./mvnw.cmd spring-boot:run"
      ],
      "port": 8080
    }
  ]
}
